# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. https://tu-app.onrender.com).
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (used automatically on Render).
# DATABASE_URL="postgresql://user:password@host:5432/database"

# DB_SSL: Set to "true" for managed PostgreSQL requiring SSL (auto-enabled for remote DATABASE_URL).
# DB_SSL="true"

# SESSION_SECRET: Long random secret string for signing session tokens in production.
# SESSION_SECRET="change_this_to_a_long_random_secret"

# ADMIN_EMAIL & ADMIN_PASSWORD: Credentials for the hidden institutional administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

